# Application
APP_NAME=Planus
TIMEZONE=America/Sao_Paulo

# CORS
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=Origin,Content-Type,Authorization
CORS_CREDENTIALS=false

# Auth
JWT_SECRET=your_jwt_secret_key

# Database
DB_CONTAINER_NAME=planus_db
DB_CONTAINER_PORT=27017
DB_HOST=${DB_CONTAINER_NAME}
DB_PORT=7776
DB_NAME=planus
DB_USER=planus
DB_PASSWORD=planus

# Database Test
DB_TEST_CONTAINER_NAME=planus_test_db
DB_TEST_CONTAINER_PORT=27017
DB_TEST_HOST=${DB_TEST_CONTAINER_NAME}
DB_TEST_PORT=7778
DB_TEST_NAME=planus_test
DB_TEST_USER=planus_test
DB_TEST_PASSWORD=planus_test

# Server
API_IMAGE_NAME=planus/dev/api
API_CONTAINER_NAME=planus_api
API_CONTAINER_PORT=7777
API_PORT=7777

# Other
DOCKER_COMPOSE_FILE=docker-compose.dev.yml
